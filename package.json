{
    "name": "modern-file-saver",
    "version": "3.2.1",
    "description": "Modern file saving library for browsers with File System Access API support and fallback",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./compat": {
            "import": {
                "types": "./dist/compat.d.mts",
                "default": "./dist/compat.mjs"
            },
            "require": {
                "types": "./dist/compat.d.ts",
                "default": "./dist/compat.js"
            }
        },
        "./min": {
            "types": "./dist/index.d.ts",
            "import": "./dist/min/index.mjs",
            "require": "./dist/min/index.js"
        },
        "./min/compat": {
            "import": {
                "types": "./dist/compat.d.mts",
                "default": "./dist/min/compat.mjs"
            },
            "require": {
                "types": "./dist/compat.d.ts",
                "default": "./dist/min/compat.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "CHANGELOG.md",
        "MIGRATION.md"
    ],
    "scripts": {
        "build": "tsdown",
        "changeset": "changeset",
        "changeset:version": "changeset version && pnpm install --lockfile-only",
        "changeset:publish": "pnpm run build && changeset publish",
        "format": "prettier --write \"**/*.{js,ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
        "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && eslint src test",
        "lint:fix": "eslint src test --fix",
        "prepublishOnly": "pnpm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "verify": "pnpm run lint && pnpm run format:check && pnpm test && pnpm run build"
    },
    "keywords": [
        "file",
        "save",
        "download",
        "browser",
        "file system access api",
        "blob",
        "base64",
        "file-saver",
        "filesaver",
        "saveAs",
        "file-download",
        "file-saver alternative",
        "file-saver replacement"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vkennke/modern-file-saver.git"
    },
    "author": "Valentin Kennke",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/vkennke/modern-file-saver/issues"
    },
    "homepage": "https://github.com/vkennke/modern-file-saver#readme",
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.2",
        "@eslint/js": "^10.0.1",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vitest/browser": "^5.0.0",
        "@vitest/browser-playwright": "^5.0.0",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.10.0",
        "playwright": "^1.63.0",
        "prettier": "3.9.6",
        "tsdown": "^0.23.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.0"
    },
    "engines": {
        "node": ">=22"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || >=24.0.0",
            "onFail": "error"
        }
    },
    "browserslist": [
        "defaults"
    ],
    "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
